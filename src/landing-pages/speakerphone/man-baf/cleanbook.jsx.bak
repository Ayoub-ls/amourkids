import React, { useEffect, useRef, useState } from "react";
import kitImage from '../images/kit.jpeg'

/*
  cleanbook.jsx  -  Page 2 of the funnel (the product + order form).
  Props:
    backHref   link of the back button (page 1)               default "/"
    kitImage   product photo                                  default "/kit.jpg"
    endpoint   URL that receives the order as JSON (POST).    default ""  (empty = nothing is sent!)
*/

const CSS = `@import url("https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=Tajawal:wght@400;500;700&display=swap");
.cl{
  --bg:#F4F5EF; --surface:#FFFFFF; --ink:#12151C; --muted:#5B6270; --line:#DDE0D6;
  --alert:#E8480F; --ok:#0E9F6E; --lime:#C8F53B; --lime-deep:#6E8F0A;
  --btn-bg:#12151C; --btn-fg:#C8F53B; --btn-sh:#6E8F0A;
  --t-alert:#FFE9DF; --t-lime:#F0FAC8; --t-ok:#DAF3E8; --t-grey:#E8EAE2;
  --font-display:"Cairo","Tajawal","Segoe UI",Tahoma,sans-serif;
  --font-body:"Tajawal","Segoe UI",Tahoma,Arial,sans-serif;
}
@media (prefers-color-scheme: dark){.cl:not([data-theme="light"]){
    --bg:#0E1117; --surface:#181D27; --ink:#F1F3EA; --muted:#A2A9B8; --line:#2A3140;
    --alert:#FF7440; --ok:#34D399;
    --btn-bg:#C8F53B; --btn-fg:#12151C; --btn-sh:#7D9C0F;
    --t-alert:#3A2419; --t-lime:#2C3314; --t-ok:#173A2E; --t-grey:#222835;
  }}
.cl[data-theme="dark"]{
  --bg:#0E1117; --surface:#181D27; --ink:#F1F3EA; --muted:#A2A9B8; --line:#2A3140;
  --alert:#FF7440; --ok:#34D399;
  --btn-bg:#C8F53B; --btn-fg:#12151C; --btn-sh:#7D9C0F;
  --t-alert:#3A2419; --t-lime:#2C3314; --t-ok:#173A2E; --t-grey:#222835;
}
.cl *,.cl *::before,.cl *::after{box-sizing:border-box}
.cl{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:18px;line-height:1.75;-webkit-text-size-adjust:100%}
.cl img{max-width:100%;display:block}
.cl a{color:inherit}
.cl .wrap{max-width:520px;margin:0 auto;padding:0 20px}
.cl h1,.cl h2,.cl h3{font-family:var(--font-display);font-weight:800;line-height:1.4;margin:0}
.cl p{margin:0}
.cl [hidden]{display:none!important}
.cl .pills{height:12px;background:var(--ink);
  -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='12'><rect width='24' height='12' rx='6'/></svg>") repeat-x;
  mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='12'><rect width='24' height='12' rx='6'/></svg>") repeat-x}
.cl .btn{display:block;width:100%;border:0;cursor:pointer;text-align:center;text-decoration:none;
  font-family:var(--font-display);font-weight:800;font-size:20px;line-height:1.5;color:var(--btn-fg);
  background:var(--btn-bg);padding:15px 20px;border-radius:16px;box-shadow:0 6px 0 var(--btn-sh);
  transition:transform .12s,box-shadow .12s}
.cl .btn:active{transform:translateY(4px);box-shadow:0 2px 0 var(--btn-sh)}
.cl .btn:disabled{opacity:.7}
.cl .btn:focus-visible,.cl .opt:focus-within,.cl summary:focus-visible,.cl input:focus-visible,.cl select:focus-visible,.cl .back:focus-visible{outline:3px solid var(--alert);outline-offset:3px}
.cl .btn small{display:block;font-family:var(--font-body);font-weight:500;font-size:14px;opacity:.9}
.cl .section{padding:44px 0}
.cl .section h2{font-size:27px;margin-bottom:22px}
.cl .foot{padding:26px 0 40px;text-align:center;color:var(--muted);font-size:14px}
.cl .top{display:flex;align-items:center;justify-content:space-between;padding:14px 0}
.cl .back{background:none;border:0;font:inherit;font-size:15px;color:var(--muted);cursor:pointer;padding:6px 2px;text-decoration:none}
.cl .offer-hero{text-align:center;padding:6px 0 34px}
.cl .offer-hero h1{font-size:31px;margin-bottom:12px}
.cl .offer-hero .sub{color:var(--muted);font-size:18px;margin-bottom:24px}
.cl .frame{background:var(--surface);border-radius:22px;overflow:hidden;box-shadow:0 10px 28px rgba(10,15,30,.16);margin-bottom:24px;padding-bottom:16px}
.cl .frame img{width:100%}
.cl .price-line{display:flex;align-items:baseline;justify-content:center;gap:10px;padding-top:12px}
.cl .price-line .now{font-family:var(--font-display);font-weight:800;font-size:40px;color:var(--alert)}
.cl .price-line .unit{font-weight:700}
.cl .kit{display:grid;gap:12px}
.cl .item{display:flex;gap:14px;align-items:flex-start;background:var(--surface);border:2px solid var(--line);border-radius:18px;padding:16px}
.cl .item .ico{flex:0 0 50px;height:50px;border-radius:14px;display:grid;place-items:center;font-size:26px;background:var(--t-lime)}
.cl .item h3{font-size:19px;margin-bottom:0}
.cl .item p{color:var(--muted);font-size:17px;line-height:1.6}
.cl .steps{display:grid;gap:14px;counter-reset:s}
.cl .step{display:flex;gap:14px;align-items:flex-start;font-weight:700;font-size:18px;line-height:1.6}
.cl .step::before{counter-increment:s;content:counter(s);flex:0 0 40px;height:40px;border-radius:50%;background:var(--lime);color:#12151C;display:grid;place-items:center;font-family:var(--font-display);font-size:20px}
.cl .steps-note{margin-top:16px;background:var(--t-alert);border-radius:14px;padding:12px 16px;font-size:16px}
.cl .order{background:var(--surface);padding:0 0 46px}
.cl .order .inner{padding-top:34px}
.cl .order h2{font-size:28px;margin-bottom:6px}
.cl .order .lead{color:var(--muted);margin-bottom:22px}
.cl .opts{display:grid;gap:14px;margin-bottom:22px}
.cl .opt{position:relative;display:flex;align-items:center;gap:14px;border:3px solid var(--line);border-radius:18px;padding:16px;cursor:pointer;background:var(--bg)}
.cl .opt input{position:absolute;opacity:0;inset:0;cursor:pointer}
.cl .opt .dot{flex:0 0 26px;height:26px;border-radius:50%;border:3px solid var(--muted);display:grid;place-items:center}
.cl .opt:has(input:checked){border-color:var(--ink);background:var(--t-lime)}
.cl .opt:has(input:checked) .dot{border-color:var(--ink)}
.cl .opt:has(input:checked) .dot::after{content:"";width:12px;height:12px;border-radius:50%;background:var(--ink)}
.cl .opt .name{font-family:var(--font-display);font-weight:800;font-size:20px;line-height:1.35}
.cl .opt .name span{display:block;font-family:var(--font-body);font-weight:500;font-size:15px;color:var(--muted)}
.cl .opt .cost-tag{margin-inline-start:auto;text-align:left;font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--alert);white-space:nowrap}
.cl .opt .save{position:absolute;top:-13px;inset-inline-end:14px;background:var(--ok);color:#fff;font-size:13px;font-weight:700;padding:2px 12px;border-radius:99px}
.cl label.f{display:block;font-weight:700;margin:0 0 6px;font-size:16px}
.cl .field{margin-bottom:16px}
.cl .field input[type=text],.cl .field input[type=tel],.cl .field select{width:100%;font:inherit;font-size:18px;color:var(--ink);background:var(--bg);border:2px solid var(--line);border-radius:14px;padding:13px 14px;min-height:52px}
.cl .err{color:var(--alert);font-size:14px;font-weight:700;margin-top:4px}
.cl .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cl .seg{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cl .seg label{position:relative;border:2px solid var(--line);border-radius:14px;padding:12px 8px;text-align:center;font-weight:700;font-size:16px;cursor:pointer;background:var(--bg)}
.cl .seg input{position:absolute;opacity:0;inset:0;cursor:pointer}
.cl .seg label:has(input:checked){border-color:var(--ink);background:var(--t-lime)}
.cl .seg label:focus-within{outline:3px solid var(--alert);outline-offset:2px}
.cl .total{display:flex;justify-content:space-between;align-items:center;background:var(--t-grey);border-radius:16px;padding:14px 18px;margin:6px 0 18px;font-weight:700}
.cl .total strong{font-family:var(--font-display);font-size:26px;font-weight:800}
.cl .trust{display:grid;gap:8px;margin-top:20px;font-size:16px;color:var(--muted)}
.cl .trust div::before{content:"✓";color:var(--ok);font-weight:800;margin-inline-end:8px}
.cl .done{text-align:center;padding:40px 0 20px}
.cl .done .tick{font-size:62px}
.cl .done h2{margin:10px 0 10px}
.cl details{border-bottom:2px solid var(--line);padding:14px 0}
.cl summary{cursor:pointer;font-weight:700;font-size:18px;list-style:none;display:flex;justify-content:space-between;gap:12px}
.cl summary::-webkit-details-marker{display:none}
.cl summary::after{content:"+";font-family:var(--font-display);font-size:24px;line-height:1;color:var(--alert)}
.cl details[open] summary::after{content:"–"}
.cl details p{color:var(--muted);margin-top:8px;font-size:17px}
.cl .sticky{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--bg);border-top:2px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));transition:transform .25s}
.cl .sticky.off{transform:translateY(110%)}
.cl .sticky .inner{max-width:520px;margin:0 auto;display:flex;align-items:center;gap:14px}
.cl .sticky .p{font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--alert);white-space:nowrap;line-height:1.3}
.cl .sticky .p small{display:block;font-family:var(--font-body);font-weight:500;font-size:12px;color:var(--muted)}
.cl .sticky .btn{font-size:18px;padding:11px 14px}`;

const PRICE = { 1: 2500, 2: 1700, 4: 1000 }; // price per kit by quantity

const WILAYAS = ["أدرار", "الشلف", "الأغواط", "أم البواقي", "باتنة", "بجاية", "بسكرة", "بشار", "البليدة", "البويرة", "تمنراست", "تبسة", "تلمسان", "تيارت", "تيزي وزو", "الجزائر", "الجلفة", "جيجل", "سطيف", "سعيدة", "سكيكدة", "سيدي بلعباس", "عنابة", "قالمة", "قسنطينة", "المدية", "مستغانم", "المسيلة", "معسكر", "ورقلة", "وهران", "البيض", "إليزي", "برج بوعريريج", "بومرداس", "الطارف", "تندوف", "تيسمسيلت", "الوادي", "خنشلة", "سوق أهراس", "تيبازة", "ميلة", "عين الدفلى", "النعامة", "عين تموشنت", "غرداية", "غليزان", "تيميمون", "برج باجي مختار", "أولاد جلال", "بني عباس", "عين صالح", "عين قزام", "تقرت", "جانت", "المغير", "المنيعة"];

const OFFERS = [
  { q: 1, title: "كيت واحد", note: "لتليفونك" },
  { q: 2, title: "كيتين: واحد ليك و واحد لانسان قريب ليك", note: "1700 دج للكيت • 3400 دج", save: "وفّر 1600 دج", per: true },
  { q: 4, title: "كيت لكل تيليفون في الدار", note: "1000 دج للكيت • 4000 دج", save: "وفّر 6000 دج", per: true },
];

const KIT = [
  ["⬛", "ملصقات الباف", "تغطي الباف و تحميه من الغبار."],
  ["🔌", "تغطي الكونكتور كي ما تشارجيش، باش الغبار ما يدخلش.."],
  ["🪥", "10 فرشات رفيعة", "تدخل في الكونكتور و تخرج الوسخ"],
  ["🖌️", "فرشاتين بمقبض", "لتنظيف الباف و الحواف و الأزرار بحركات خفيفة."],
  ["🔧", "ملقط", "يخرج الوبر و الوسخ اللي ما تقدرش توصلو الفرشاة."],
];

const FAQ = [
  [" يخدم لكل الهواتف؟", "الفرشات و الملقط و ملصقات الباف تخدم مع أي هاتف. بالنسبة للسدادات، نأكدو معاك نوع كونكتور تليفونك في مكالمة التأكيد."],
  [" يخرّب الكونكتور", "لا. الفرشات ناعمة. المهم تطفي التليفون و تخدم بحركات خفيفة، بلا قوة."],
  [" يصلح كل مشاكل الشحن؟", "لا. كي يكون السبب وسخ متراكم، غالباً يرجع الشحن و الصوت. أما إذا المشكل في البطارية أو الكابل، التنظيف ما يبدلهوش."],
  ["كيفاش ندفع؟", "الدفع عند الاستلام. تستلم الكيت و تدفع للموزع."],
  [" تتصلو بيا قبل الشحن؟", "إيه. نتصلو بيك في الهاتف باش نأكدو الطلب و العنوان."],
  ["نقدر نطلب أكثر من كيت؟", "إيه. كيتين بـ 1700 دج للكيت، و 4 كيتات بـ 1000 دج للكيت."],
];

export default function CleanBook({ backHref = "/", endpoint = "" }) {
  const [qty, setQty] = useState(1);
  const [form, setForm] = useState({ name: "", phone: "", wilaya: "", commune: "", delivery: "home" });
  const [errors, setErrors] = useState({});
  const [sending, setSending] = useState(false);
  const [sendErr, setSendErr] = useState("");
  const [done, setDone] = useState(null);
  const [hideSticky, setHideSticky] = useState(false);
  const orderRef = useRef(null);

  const total = qty * PRICE[qty];
  const set = (k) => (e) => setForm((f) => ({ ...f, [k]: e.target.value }));
  const goOrder = () => orderRef.current && orderRef.current.scrollIntoView({ behavior: "smooth", block: "start" });

  useEffect(() => {
    const el = orderRef.current;
    if (!el || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver((en) => setHideSticky(en[0].isIntersecting), { threshold: 0.15 });
    io.observe(el);
    return () => io.disconnect();
  }, []);

  async function submit(e) {
    e.preventDefault();
    const phone = form.phone.replace(/[\s.\-]/g, "");
    const er = {};
    if (form.name.trim().length < 3) er.name = "اكتب الإسم و اللقب";
    if (!/^0[567]\d{8}$/.test(phone)) er.phone = "رقم الهاتف لازم يبدأ بـ 05 أو 06 أو 07 و فيه 10 أرقام";
    if (!form.wilaya) er.wilaya = "اختر الولاية";
    if (!form.commune.trim()) er.commune = "اكتب البلدية";
    setErrors(er);
    if (Object.keys(er).length) return;

    const order = {
      product: "phone-cleaning-kit",
      name: form.name.trim(), phone, wilaya: form.wilaya, commune: form.commune.trim(),
      delivery: form.delivery, quantity: qty, unitPrice: PRICE[qty], total,
      createdAt: new Date().toISOString(),
    };
    setSending(true); setSendErr("");
    try {
      if (endpoint) {
        const r = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(order) });
        if (!r.ok) throw new Error("bad status");
      } else {
        console.warn("CleanBook: no `endpoint` prop set, the order was NOT sent anywhere.", order);
      }
      setDone(phone);
      setTimeout(() => orderRef.current && orderRef.current.scrollIntoView({ behavior: "smooth", block: "start" }), 50);
    } catch (err) {
      setSendErr("صرا مشكل في الإرسال. عاود حاول من فضلك.");
    } finally {
      setSending(false);
    }
  }

  return (
    <div className="cl" dir="rtl" lang="ar" style={{ paddingBottom: 90 }}>
      <style>{CSS}</style>
      <main>
        <div className="pills" />
        <div className="wrap">
          <div className="top"><a className="back" href={backHref}>‹ رجوع</a></div>

          <section className="offer-hero">
            <h1>نقي الباف بيدك، و غطيه باش ما يتوسخش</h1>
            <p className="sub">كيت كامل ينقي لوسخ من الباف و الكونكتور، و فيه سدادات و ملصقات تحميهم من الغبار.</p>
            <div className="frame">
              <img src={kitImage} alt="كيت تنظيف الهاتف" width="660" height="495" />
              <div className="price-line"><span className="now">2500</span><span className="unit">دج</span></div>
            </div>
            <button className="btn" type="button" onClick={goOrder}>اطلب الآن – الدفع عند الاستلام</button>
          </section>
        </div>

        <section className="section">
          <div className="wrap">
            <h2>واش فيه الكيت؟</h2>
            <div className="kit">
              {KIT.map(([e, t, d]) => (
                <div className="item" key={t}><div className="ico">{e}</div><div><h3>{t}</h3><p>{d}</p></div></div>
              ))}
            </div>
          </div>
        </section>

        <section className="section" style={{ paddingTop: 8 }}>
          <div className="wrap">
            <h2>كيفاش تخدمو؟</h2>
            <div className="steps">
              <div className="step">طفي التليفون.</div>
              <div className="step">نقي الباف بالفرشاة، و اخرج الوسخ بالملقط</div>
              <div className="step">ركّب الملصق على الباف، و السدادة على الكونكتور كي ما تشارجيش.</div>
            </div>
            <p className="steps-note">⚠️ نقي بلعقل و ما تدخلش الفرشاة بالقوة.</p>
          </div>
        </section>

        {/* REAL BEFORE/AFTER PHOTOS OR A SHORT DEMO VIDEO GO HERE (add a section once you have them) */}

        <section className="order" ref={orderRef}>
          <div className="pills" />
          <div className="wrap inner">
            {done ? (
              <div className="done">
                <div className="tick">✅</div>
                <h2>وصلنا طلبك!</h2>
                <p>
                  راح نتصلو بيك قريب على الرقم <b dir="ltr">{done}</b> باش نأكدو العنوان.
                  <br />
                  بارك الله فيك 🤍
                </p>
              </div>
            ) : (
              <>
                <h2>اطلب الكيت الآن</h2>
                <p className="lead">تدفع كي يوصلك. ما تدفع والو من قبل.</p>

                <form onSubmit={submit} noValidate>
                  <div className="opts" role="radiogroup" aria-label="اختر العرض">
                    {OFFERS.map((o) => (
                      <label className="opt" key={o.q}>
                        {o.save && <span className="save">{o.save}</span>}
                        <input type="radio" name="offer" value={o.q} checked={qty === o.q} onChange={() => setQty(o.q)} />
                        <span className="dot" />
                        <span className="name">{o.title} <span>{o.note}</span> </span>
                        <span className="cost-tag">
                          {PRICE[o.q]} دج
                          {o.per && <small style={{ display: "block", fontSize: 13, fontFamily: "var(--font-body)", fontWeight: 500, color: "var(--muted)" }}>للكيت</small>}
                        </span>
                      </label>
                    ))}
                  </div>

                  <div className="field">
                    <label className="f" htmlFor="cl-name">الإسم و اللقب</label>
                    <input type="text" id="cl-name" autoComplete="name" placeholder="مثال: محمد بن علي" value={form.name} onChange={set("name")} />
                    <div className="err">{errors.name}</div>
                  </div>
                  <div className="field">
                    <label className="f" htmlFor="cl-phone">رقم الهاتف</label>
                    <input type="tel" id="cl-phone" inputMode="tel" autoComplete="tel" placeholder="05 / 06 / 07 XX XX XX XX" dir="ltr" style={{ textAlign: "right" }} value={form.phone} onChange={set("phone")} />
                    <div className="err">{errors.phone}</div>
                  </div>
                  <div className="row2">
                    <div className="field">
                      <label className="f" htmlFor="cl-wilaya">الولاية</label>
                      <select id="cl-wilaya" value={form.wilaya} onChange={set("wilaya")}>
                        <option value="">اختر</option>
                        {WILAYAS.map((w, i) => (
                          <option key={w} value={w}>{String(i + 1).padStart(2, "0")} - {w}</option>
                        ))}
                      </select>
                      <div className="err">{errors.wilaya}</div>
                    </div>
                    <div className="field">
                      <label className="f" htmlFor="cl-commune">البلدية</label>
                      <input type="text" id="cl-commune" autoComplete="address-level2" value={form.commune} onChange={set("commune")} />
                      <div className="err">{errors.commune}</div>
                    </div>
                  </div>
                  <div className="field">
                    <label className="f">نوع التوصيل</label>
                    <div className="seg">
                      <label><input type="radio" name="delivery" value="home" checked={form.delivery === "home"} onChange={set("delivery")} />🏠 للدار</label>
                      <label><input type="radio" name="delivery" value="desk" checked={form.delivery === "desk"} onChange={set("delivery")} />🏢 للمكتب</label>
                    </div>
                  </div>

                  <div className="total"><span>مجموع الكيتات</span><strong>{total} دج</strong></div>
                  <button className="btn" type="submit" disabled={sending}>
                    أكد طلبي – الدفع عند الاستلام
                    <small>نتصلو بيك باش نأكدو الطلب</small>
                  </button>
                  <div className="err" role="alert" style={{ textAlign: "center", marginTop: 10 }}>{sendErr}</div>

                  <div className="trust">
                    <div>الدفع عند الاستلام</div>
                    <div>التوصيل لكل الولايات</div>
                    <div>نتصلو بيك في الهاتف قبل الشحن</div>
                  </div>
                </form>
              </>
            )}
          </div>
        </section>

        <section className="section">
          <div className="wrap">
            <h2>أسئلة يسقسيو عليها الناس</h2>
            {FAQ.map(([q, a]) => (
              <details key={q}><summary>{q}</summary><p>{a}</p></details>
            ))}
          </div>
        </section>

        <div className="pills" />
        <div className="foot wrap">الدفع عند الاستلام · التوصيل لكل الولايات</div>

        {!done && (
          <div className={"sticky" + (hideSticky ? " off" : "")}>
            <div className="inner">
              <div className="p">{PRICE[1]} دج<small>الدفع عند الاستلام</small></div>
              <button className="btn" type="button" onClick={goOrder}>اطلب الآن</button>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
